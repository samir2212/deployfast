# tutaia-infra/terraform.tfvars
# Copy this file and fill in your values
# DO NOT commit terraform.tfvars to git if it contains secrets
# Use: export TF_VAR_db_password="your-strong-password"

aws_region  = "eu-central-1"
environment = "prod"
domain_name = "tutaia.com"

vpc_cidr = "10.0.0.0/16"

availability_zones = [
  "eu-central-1a",
  "eu-central-1b"
]

public_subnet_cidrs = [
  "10.0.1.0/24",
  "10.0.2.0/24"
]

private_subnet_cidrs = [
  "10.0.10.0/24",
  "10.0.11.0/24"
]

db_instance_class = "db.t3.micro"
db_name           = "tutaia_platform"
db_username       = "tutaia_admin"
# db_password set via environment variable:
# export TF_VAR_db_password="your-strong-password-here"

# Default resources per user app task
ecs_task_cpu    = 256  # 0.25 vCPU
ecs_task_memory = 512  # 512 MB

# ── App ──────────────────────────────────────
ENVIRONMENT=production
DEBUG=false

# ── AWS ──────────────────────────────────────
AWS_REGION=eu-central-1
AWS_ACCOUNT_ID=856930835134

# ── Platform Domain ──────────────────────────
PLATFORM_DOMAIN=ai-deploy.tutaia.com

# ── ECS (from terraform output) ──────────────
ECS_CLUSTER_NAME=tutaia-cluster
ECS_TASK_EXECUTION_ROLE_ARN=arn:aws:iam::856930835134:role/tutaia-ecs-task-execution-role
ECS_TASK_ROLE_ARN=arn:aws:iam::856930835134:role/tutaia-ecs-task-role
ECS_TASKS_SECURITY_GROUP_ID=sg-07ae242b61f061806
PRIVATE_SUBNET_IDS=subnet-088505349ecd7387a,subnet-03ac7243e6039bfff

# ── ALB (from terraform output) ──────────────
ALB_HTTPS_LISTENER_ARN=arn:aws:elasticloadbalancing:eu-central-1:856930835134:listener/app/tutaia-alb/ea1da746f8f7c721/5720a2ad4fb82001

# ── ECR ──────────────────────────────────────
ECR_BASE_URL=856930835134.dkr.ecr.eu-central-1.amazonaws.com

# ── S3 ───────────────────────────────────────
UPLOADS_BUCKET_NAME=tutaia-app-uploads-856930835134

# ── Database ─────────────────────────────────
# Get this from: aws ssm get-parameter --name /tutaia/platform/database_url --with-decryption
DATABASE_URL=postgresql://tutaia_admin:YOUR_PASSWORD@YOUR_RDS_ENDPOINT:5432/tutaia_platform

# ── Clerk Auth ───────────────────────────────
# Get these from https://dashboard.clerk.com → your app → API Keys
CLERK_SECRET_KEY=sk_live_YOUR_KEY_HERE
CLERK_PUBLISHABLE_KEY=pk_live_YOUR_KEY_HERE

# ── Task Resources ───────────────────────────
DEFAULT_TASK_CPU=256
DEFAULT_TASK_MEMORY=512

# ─── Secrets & credentials ───────────────────────
.env
.env.*
!.env.example
*.tfvars
!*.tfvars.example

# ─── Terraform ────────────────────────────────────
*.tfstate
*.tfstate.backup
.terraform/
.terraform.lock.hcl
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

